# ============================================================
# Netlify _headers — Security & Caching
# Drop this file at the repo root (or public/) when deploying to Netlify.
# For Vercel, port to vercel.json (see README).
# ============================================================

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://plausible.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Long cache for hashed assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Short cache for HTML — always revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Sitemaps & robots — fresh
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
